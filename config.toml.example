# ~/.config/kanban/config.toml
#
# Copy this file to ~/.config/kanban/config.toml (or pass --config FILE to
# kanban, approve_issues.py, and drain_prs.py) to override the defaults
# below. A missing file silently uses these defaults. A malformed file, or a
# known key with an invalid value, fails startup and names the file and the
# full key path. Unknown keys and tables warn with their full key paths but
# do not prevent loading.
#
# All keys shown here are global defaults.

cache = true
remote_name = "origin"

[workflow]
approval_label = "reviewed:approve"
changes_requested_label = "reviewed:changes"
blocked_labels = ["blocked"]
tracker_labels = ["epic"]
additional_tracker_section_headings = []
approval_mode = "label"        # "label", "review", or "either"
blocking_severity = "red"      # "red" or "amber"
# Display only: label names tinted like a problem, and like a UI concern, in
# the card and details label chips. Matched case-insensitively; neither
# affects status, readiness, or ordering. Both default to empty, so an
# unlisted label renders as an ordinary chip. A name in both lists is tinted
# as a problem. E.g. problem_style_labels = ["bug"], ui_style_labels = ["ui",
# "input"] restores the tints Kanban used to hardcode.
problem_style_labels = []
ui_style_labels = []
# Paths whose content coordinates the pipeline rather than building it. The PR
# drainer may merge a candidate whose only distance from the default branch is
# a change to these, instead of first rebuilding it on a new base that cannot
# change its result. Each entry is one exact, case-sensitive, repository-
# relative path: no globs, no directory prefixes, no extension matching, and a
# rename counts both endpoints, so configure every path you mean. Empty by
# default, which requests a branch update for every advance as before. Never
# list a document a test parses -- a change to one really can fail CI.
coordination_paths = []

[limits]
excerpt_lines = 3

# github_seconds bounds one page of the open-issue and open-pull-request
# traversal rather than the whole refresh: a repository large enough to need
# many pages gets the full budget for each of them. Values are positive whole
# seconds.
[timeouts]
github_seconds = 30
codex_seconds = 10
claude_seconds = 45

# Omit `command` to use the built-in provider. When present it is a non-empty
# argv array whose first element is a non-empty executable path/name,
# direct-exec'd (no shell) under the matching provider timeout above in place
# of the built-in provider. It must print
# {"windows": [{"label": "5 hour", "pct_left": 78, "resets_at": "2026-07-16T16:05:00Z"}]}
# on stdout.
[usage.codex]
# command = ["/usr/local/bin/my-codex-usage", "--json"]

[usage.claude]
# command = ["/usr/local/bin/my-claude-usage", "--json"]

# The quoted key must be a canonical lowercase owner/name: two non-empty
# segments of [a-z0-9._-] around exactly one slash, with no uppercase letters,
# surrounding whitespace, URL or SSH remote syntax, `.git` suffix, or extra
# slashes. Anything else is a startup configuration error rather than a table
# that silently never applies. This is deliberately stricter than `--repo`,
# which you type per invocation and which still accepts the GitHub URL forms
# it always has. The owner/name resolved from the remote or `--repo` is folded
# to lowercase for this lookup only, so a `Coghex/Kanban` clone selects the
# `coghex/kanban` key below.
#
# Only [workflow], [limits], and [timeouts] may appear below the key.
# `cache`, `remote_name`, and `usage` are global-only and fail if set here.
# Omitted values inherit from the global table; an array replaces the global
# array in full rather than extending it.

[repositories."owner/name".workflow]
# approval_label = "reviewed:approve"
# changes_requested_label = "reviewed:changes"
# blocked_labels = ["blocked"]
# tracker_labels = ["epic"]
# additional_tracker_section_headings = []
# approval_mode = "label"
# blocking_severity = "red"
# problem_style_labels = []
# ui_style_labels = []
# coordination_paths = []

[repositories."owner/name".limits]
# excerpt_lines = 3

[repositories."owner/name".timeouts]
# github_seconds = 30
# codex_seconds = 10
# claude_seconds = 45
