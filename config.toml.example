# ~/.config/kanban/config.toml
#
# Copy this file to ~/.config/kanban/config.toml (or pass --config FILE to
# kanban, approve_issues.py, and drain_prs.py) to override the defaults
# below. A missing file silently uses these defaults. A malformed file, or a
# known key with an invalid value, fails startup and names the file and the
# full key path. Unknown keys and tables warn with their full key paths but
# do not prevent loading.
#
# All keys shown here are global defaults.

cache = true
remote_name = "origin"

[workflow]
approval_label = "reviewed:approve"
changes_requested_label = "reviewed:changes"
blocked_labels = ["blocked"]
tracker_labels = ["epic"]
additional_tracker_section_headings = []
approval_mode = "label"        # "label", "review", or "either"
blocking_severity = "red"      # "red" or "amber"
# Display only: label names tinted like a problem, and like a UI concern, in
# the card and details label chips. Matched case-insensitively; neither
# affects status, readiness, or ordering. Both default to empty, so an
# unlisted label renders as an ordinary chip. A name in both lists is tinted
# as a problem. E.g. problem_style_labels = ["bug"], ui_style_labels = ["ui",
# "input"] restores the tints Kanban used to hardcode.
problem_style_labels = []
ui_style_labels = []
# Both keys below take the SAME entry grammar: one case-sensitive,
# repository-relative path per entry -- an exact file, or a directory declared
# with a trailing slash, which covers every descendant by whole path component
# ("docs/notes/" covers docs/notes/plan.md and never a sibling directory such
# as docs/notes-old/). No globs, no string prefixes, no extension matching.
# They answer different questions, and a path in one implies nothing about the
# other. Never list a document a test parses in either -- a change to one
# really can fail CI.
#
# coordination_paths: the PR DRAINER's merge exception. The drainer may merge a
# candidate whose only distance from the default branch is a change to these,
# instead of first rebuilding it on a new base that cannot change its result. A
# rename counts both endpoints, so a rename out of a declared directory is not a
# covered advance. Empty by default, which requests a branch update for every
# advance as before. This key grants NO publication lane.
coordination_paths = []
# direct_publication_paths: the AGENT PUBLICATION lane -- which documents a
# document workflow may push straight to the default branch, unattended, in the
# same run that approves the mutation. Read only by
# tools/publish_coordination_doc.py, and only for a repository
# docs/agent-workflow-contract.md section 7 does not classify, which is every
# repository but Kanban's own; Kanban's lane comes from section 7 and
# configuration can neither open nor close it.
#
# Empty by default, and leaving it out entirely is a supported, deliberate
# configuration: a workflow whose document is not covered applies its approved
# mutation to the working copy, records it, reports not-published, and the edits
# accumulate for a human to land in one batch (tools/docs_land.sh). Declare a
# path here only if you want an unattended default-branch push per approved
# disposition -- and note that each such push is itself an advance the drainer
# must then answer for every open approved PR.
direct_publication_paths = []

[limits]
excerpt_lines = 3

# github_seconds bounds one page of the open-issue and open-pull-request
# traversal rather than the whole refresh: a repository large enough to need
# many pages gets the full budget for each of them. Values are positive whole
# seconds.
#
# codex_seconds and claude_seconds bound an account-status read. The
# ping_* keys bound the single model request `kanban --ping codex` and
# `kanban --ping claude` submit, which is a much longer operation, so they
# are separate keys with their own 120-second defaults.
[timeouts]
github_seconds = 30
codex_seconds = 10
claude_seconds = 45
ping_codex_seconds = 120
ping_claude_seconds = 120

# Omit `command` to use the built-in provider. When present it is a non-empty
# argv array whose first element is a non-empty executable path/name,
# direct-exec'd (no shell) under the matching provider timeout above in place
# of the built-in provider. It must print
# {"windows": [{"label": "5 hour", "pct_left": 78, "resets_at": "2026-07-16T16:05:00Z"}]}
# on stdout.
#
# `estimated_percent_per_solve_round` is what you estimate one solve round
# costs that provider, as a whole percentage of a window: an integer from 1
# through 100, and anything else is a startup error. It is independent of
# `command` — either key may be set without the other — and setting it makes
# `kanban --usage`, `kanban --ping`, and the sidebar report roughly how many
# rounds the remaining percentage buys, rounded down. Omit it and no estimate
# is shown; there is no default. Both keys are global, like the rest of
# [usage]; they cannot be set per repository.
[usage.codex]
# command = ["/usr/local/bin/my-codex-usage", "--json"]
# estimated_percent_per_solve_round = 8

[usage.claude]
# command = ["/usr/local/bin/my-claude-usage", "--json"]
# estimated_percent_per_solve_round = 12

# The quoted key must be a canonical lowercase owner/name: two non-empty
# segments of [a-z0-9._-] around exactly one slash, with no uppercase letters,
# surrounding whitespace, URL or SSH remote syntax, `.git` suffix, or extra
# slashes. Anything else is a startup configuration error rather than a table
# that silently never applies. This is deliberately stricter than `--repo`,
# which you type per invocation and which still accepts the GitHub URL forms
# it always has. The owner/name resolved from the remote or `--repo` is folded
# to lowercase for this lookup only, so a `Coghex/Kanban` clone selects the
# `coghex/kanban` key below.
#
# Only [workflow], [limits], and [timeouts] may appear below the key.
# `cache`, `remote_name`, and `usage` are global-only and fail if set here.
# Omitted values inherit from the global table; an array replaces the global
# array in full rather than extending it.

[repositories."owner/name".workflow]
# approval_label = "reviewed:approve"
# changes_requested_label = "reviewed:changes"
# blocked_labels = ["blocked"]
# tracker_labels = ["epic"]
# additional_tracker_section_headings = []
# approval_mode = "label"
# blocking_severity = "red"
# problem_style_labels = []
# ui_style_labels = []
# coordination_paths = []
# direct_publication_paths = []

[repositories."owner/name".limits]
# excerpt_lines = 3

[repositories."owner/name".timeouts]
# github_seconds = 30
# codex_seconds = 10
# claude_seconds = 45
# ping_codex_seconds = 120
# ping_claude_seconds = 120

# Kanban's own repository, and the one live table in this file. The entries
# below are exactly the `coordination` rows of docs/agent-workflow-contract.md
# section 7 -- the findings, code-health, and design documents whose content no
# runtime, installer, or test reads, plus the docs/coordination/ directory of
# free-form notes, declared once rather than per file -- so the drainer may
# merge past an advance that only touches them instead of requesting a branch
# update that cannot change the result. tools/test_document_classification.py
# reconciles this list against those rows by effective coverage, so the two
# cannot drift; it also asserts that no entry covers a document a test parses,
# which is what the warning above the global default asks of every entry. That
# global default stays empty: this classification describes this repository
# and is never inferred for another.
[repositories."coghex/kanban".workflow]
coordination_paths = [
  "docs/card_filter_design.md",
  "docs/claude_document_workflows_design.md",
  "docs/code-health-report.md",
  "docs/coordination/",
  "docs/document_workflow_findings.md",
  "docs/drainer-bugs.md",
  "docs/gh_record_authority_design.md",
  "docs/issue_approval_queue_design.md",
  "docs/issue_search_design.md",
  "docs/linux_portability_design.md",
  "docs/managed_paths_design.md",
  "docs/model_settings_design.md",
  "docs/multi_repo_boards_design.md",
  "docs/overlay_focus_fullscreen_design.md",
  "docs/pipeline-hardening.md",
  "docs/product_readiness_findings.md",
  "docs/project_review_183-170.md",
  "docs/project_review_195-185.md",
  "docs/project_review_218-196.md",
  "docs/project_review_244-219.md",
  "docs/project_review_271-251.md",
  "docs/project_review_297-272.md",
  "docs/project_review_314-299.md",
  "docs/project_review_342-317.md",
  "docs/project_review_386-361.md",
  "docs/project_review_442-411.md",
  "docs/project_review_456-446.md",
  "docs/project_review_463-455.md",
  "docs/public_release_design.md",
  "docs/superagent_design.md",
  "docs/ui-bugs.md",
  "docs/usage_awareness_design.md",
  "docs/workflow_audit_findings.md",
  "docs/workflow_command_vendoring_design.md",
]
