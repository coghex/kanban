    Kanban.Worker.IssueHost
    Kanban.Worker.Monitor
    Kanban.Worker.Paths
    Kanban.Worker.Termination
    Kanban.Worker.Types
  build-depends:
    aeson                 >= 2.2 && < 2.3,
    base                  >= 4.20 && < 4.22,
    brick                 >= 2.6 && < 2.11,
    bytestring            >= 0.12 && < 0.13,
    containers            >= 0.7 && < 0.8,
    directory             >= 1.3.7 && < 1.4,
    filepath              >= 1.4 && < 1.6,
    optparse-applicative  >= 0.18 && < 0.20,
    process               >= 1.6 && < 1.7,
    text                  >= 2.1 && < 2.2,
    time                  >= 1.12 && < 1.16,
    toml-parser           >= 2.0 && < 2.1,
    transformers          >= 0.6 && < 0.7,
    unicode-transforms    >= 0.4 && < 0.5,
    unix                  >= 2.8 && < 2.9,
    vty                   >= 6.2 && < 6.6

executable kanban
  import: warnings
  hs-source-dirs: app
  main-is: Main.hs
  ghc-options: -threaded -rtsopts -with-rtsopts=-N1
  build-depends:
    base,
    kanban:kanban-internal,
    optparse-applicative,
    text

