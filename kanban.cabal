    Kanban.UI.Worker
    Kanban.Usage
    Kanban.Usage.Render
    Kanban.UsageCommand
    Kanban.Worker
    Kanban.Workflow
  other-modules:
    Kanban.Action.AutoSolve
    Kanban.Action.Capability
    Kanban.Action.Dispatch
    Kanban.Action.Target
    Kanban.Action.Types
    Kanban.GitHub.Coordinator
    Kanban.GitHub.Decode
    Kanban.GitHub.Fetch
    Kanban.GitHub.Group
    Kanban.GitHub.Guard
    Kanban.GitHub.History
    Kanban.GitHub.Message
    Kanban.GitHub.Rate
    Kanban.GitHub.Run
    Kanban.GitHub.Warnings
    Kanban.Mission.Control
    Kanban.Mission.Controller
    Kanban.Mission.Digest
    Kanban.Mission.Invocation
    Kanban.Mission.Journal
    Kanban.Mission.Lease
    Kanban.Mission.Paths
    Kanban.Mission.Reconcile
    Kanban.Mission.Runner
    Kanban.Mission.Session
    Kanban.Mission.Store
    Kanban.Mission.Types
    Kanban.ServiceProcess
    Kanban.Preflight.Environment
    Kanban.Preflight.Readiness
    Kanban.ProviderAdapter
    Kanban.Review.Canonical
    Kanban.Review.Client
    Kanban.Review.Connection
    Kanban.Review.Diagnostics
    Kanban.Review.Prompts
    Kanban.Review.Stream
    Kanban.Review.Tools
    Kanban.Review.Types
    Kanban.Solve.Event
    Kanban.Solve.Parse
    Kanban.Solve.Unknown
    Kanban.Worker.Census
    Kanban.Worker.Command
