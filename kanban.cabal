    Kanban.UI
    Kanban.UI.Approval
    Kanban.UI.AutoSolve
    Kanban.UI.Board
    Kanban.UI.Details
    Kanban.UI.Events
    Kanban.UI.Filter
    Kanban.UI.Keys
    Kanban.UI.Overlay
    Kanban.UI.PullRequest
    Kanban.UI.Reconcile
    Kanban.UI.Refresh
    Kanban.UI.Review
    Kanban.UI.Search
    Kanban.UI.Selection
    Kanban.UI.Session
    Kanban.UI.SessionCore
    Kanban.UI.SessionEvents
    Kanban.UI.Settings
    Kanban.UI.Solve
    Kanban.UI.Notice
    Kanban.UI.State
    Kanban.UI.Theme
    Kanban.UI.Transcript
