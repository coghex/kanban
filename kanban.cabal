cabal-version:      3.0
name:               kanban
version:            1.1.0.0
synopsis:           Event-driven GitHub workflow dashboard for the terminal
description:
  A lightweight, keyboard-driven terminal dashboard combining a GitHub
  workflow board with on-demand Codex and Claude usage information.
homepage:           https://github.com/coghex/kanban
bug-reports:        https://github.com/coghex/kanban/issues
license:            MIT
license-file:       LICENSE
author:             Terry Coghlan
maintainer:         Terry Coghlan <vincecoghlan@gmail.com>
category:           Development
build-type:         Simple
-- The source distribution is a complete Kanban checkout: everything needed to
-- build, test, configure, and provision the advertised features from the
-- unpacked archive. `tools/test_source_distribution.py` is the regression that
-- keeps it that way, and records why each tracked root asset is in or out.
extra-source-files:
  cabal.project
  test/fixtures/*.toml
  test/fixtures/*.txt
  test/golden/*.attrs
  test/golden/*.txt
  tools/**/*.md
  tools/**/*.py
  tools/**/*.sh
  codex-plugin/**/*.json
  codex-plugin/**/*.md
  codex-plugin/**/*.py
  claude-plugin/**/*.json
  claude-plugin/**/*.md
  claude-plugin/**/*.py

  -- The four files `plugin marketplace add` actually reads. Cabal 3.16's
  -- recursive globs do reach them under their dot-prefixed directories, so
  -- these lines are redundant today; they are kept because that is the one
  -- glob-semantics detail whose silent change would strand both bundles
  -- while every other bundle file still shipped.
  codex-plugin/.agents/plugins/marketplace.json
  codex-plugin/plugins/kanban/.codex-plugin/plugin.json
  claude-plugin/.claude-plugin/marketplace.json
  claude-plugin/plugins/kanban/.claude-plugin/plugin.json

extra-doc-files:
  .github/pull_request_template.md
  AGENTS.md
  CHANGELOG.md
  CLAUDE.md
  CODE_OF_CONDUCT.md
  CONTRIBUTING.md
  README.md
  SECURITY.md
  SUPPORT.md
  config.toml.example
  models.toml.example
  docs/README.md
  docs/agent-workflow-contract.md
  docs/bugs.md
  docs/development.md
  docs/design.md
  docs/document-workflow-contract.md
  docs/drafting-workflow-contract.md
  docs/issue-approval.md
  docs/media/README.md
  docs/media/board-wide.png
  docs/media/board-wide.provenance
  docs/pr-drainer.md
  docs/releasing.md
  docs/user-guide.md
  docs/workflow-setup.md

source-repository head
  type: git
  location: https://github.com/coghex/kanban.git

common warnings
  default-language: GHC2024
  default-extensions:
    OverloadedRecordDot
    OverloadedStrings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wpartial-fields
    -Wredundant-constraints

-- The implementation modules are a private component, not a supported Haskell
-- API. Kanban's supported interfaces are the executable, its CLI, the
-- documented configuration, the on-disk compatibility surface, the installers,
-- and the workflow contracts; importing `Kanban.*` is not among them, so this
-- package publishes no library for an outside package to depend on.
library kanban-internal
  import: warnings
  visibility: private
  hs-source-dirs: src
  exposed-modules:
    Kanban.Action
    Kanban.ApprovalService
    Kanban.CLI
    Kanban.Cache
    Kanban.Card
    Kanban.Claude
    Kanban.Codex
    Kanban.CommandCapture
    Kanban.Config
    Kanban.Domain
    Kanban.Filter
    Kanban.Drainer
    Kanban.Fixture
    Kanban.GlyphTest
    Kanban.GitHub
    Kanban.Layout
    Kanban.ManagedPaths
    Kanban.Mission
    Kanban.Models
    Kanban.Paths
    Kanban.Ping
    Kanban.Preflight
    Kanban.Process
    Kanban.Provider
    Kanban.PullRequestFlow
    Kanban.Repository
    Kanban.Repository.Authority
    Kanban.Repository.Lease
    Kanban.Review
    Kanban.ReviewToolServer
    Kanban.Settings
    Kanban.Solve
    Kanban.StreamReader
    Kanban.Text
    Kanban.Transcript
