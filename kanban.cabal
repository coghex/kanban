cabal-version:      3.0
name:               kanban
version:            0.1.0.0
synopsis:           Event-driven GitHub workflow dashboard for the terminal
description:
  A lightweight, keyboard-driven terminal dashboard combining a GitHub
  workflow board with on-demand Codex and Claude usage information.
homepage:           https://github.com/coghex/kanban
bug-reports:        https://github.com/coghex/kanban/issues
license:            MIT
license-file:       LICENSE
author:             coghex
maintainer:         coghex
category:           Development
build-type:         Simple
extra-source-files:
  test/golden/*.attrs
  test/golden/*.txt

extra-doc-files:
  config.toml.example
  docs/README.md
  docs/development.md
  docs/design.md
  docs/pr-drainer.md
  docs/user-guide.md
  docs/workflow-setup.md

source-repository head
  type: git
  location: https://github.com/coghex/kanban.git

common warnings
  default-language: GHC2024
  default-extensions:
    OverloadedRecordDot
    OverloadedStrings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wpartial-fields
    -Wredundant-constraints

library
  import: warnings
  hs-source-dirs: src
  exposed-modules:
    Kanban.CLI
    Kanban.Cache
    Kanban.Card
    Kanban.Claude
    Kanban.Codex
    Kanban.CommandCapture
    Kanban.Config
    Kanban.Domain
    Kanban.Drainer
    Kanban.Fixture
    Kanban.GlyphTest
    Kanban.GitHub
    Kanban.Layout
    Kanban.Paths
    Kanban.Preflight
    Kanban.Process
    Kanban.Provider
    Kanban.PullRequestFlow
    Kanban.Repository
    Kanban.Review
    Kanban.Settings
    Kanban.Solve
    Kanban.StreamReader
    Kanban.Text
    Kanban.Transcript
    Kanban.Tracker
    Kanban.UI
    Kanban.UsageCommand
    Kanban.Worker
    Kanban.Workflow
  build-depends:
    aeson                 >= 2.2 && < 2.3,
    base                  >= 4.20 && < 4.22,
    brick                 >= 2.6 && < 2.11,
    bytestring            >= 0.12 && < 0.13,
    containers            >= 0.7 && < 0.8,
    directory             >= 1.3 && < 1.4,
    filepath              >= 1.4 && < 1.6,
    optparse-applicative  >= 0.18 && < 0.20,
    process               >= 1.6 && < 1.7,
    text                  >= 2.1 && < 2.2,
    time                  >= 1.12 && < 1.16,
    toml-parser           >= 2.0 && < 2.1,
    transformers          >= 0.6 && < 0.7,
    unicode-transforms    >= 0.4 && < 0.5,
    unix                  >= 2.8 && < 2.9,
    vty                   >= 6.2 && < 6.6

executable kanban
  import: warnings
  hs-source-dirs: app
  main-is: Main.hs
  ghc-options: -threaded -rtsopts -with-rtsopts=-N1
  build-depends:
    base,
    kanban,
    optparse-applicative,
    text

test-suite kanban-test
  import: warnings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  other-modules:
    Spec.Agent.Capture
    Spec.Agent.IssueReviewer
    Spec.Agent.ManagedProcess
    Spec.Agent.ManagedProcess.Deadline
    Spec.Agent.ManagedProcess.Lifecycle
    Spec.Agent.Preflight
    Spec.Agent.Protocol
    Spec.Agent.PullRequestFlow
    Spec.Agent.Solve
    Spec.Agent.Supervision
    Spec.Agent.Transcript
    Spec.Agent.Usage
    Spec.Board.Tracker
    Spec.Board.Workflow
    Spec.Config.Consumers
    Spec.Config.Loading
    Spec.Config.Settings
    Spec.Drainer
    Spec.Drainer.DirectMerge
    Spec.GitHub.BoardRefresh
    Spec.GitHub.Decoding
    Spec.GitHub.PullRequestStatus
    Spec.Repository.Identity
    Spec.Repository.State
    Spec.Support.App
    Spec.Support.Board
    Spec.Support.ClaudeProbe
    Spec.Support.Env
    Spec.Support.Expect
    Spec.Support.Fixtures
    Spec.Support.Golden
    Spec.Support.Json
    Spec.Support.Locale
    Spec.Support.Preflight
    Spec.Support.Process
    Spec.Support.Render
    Spec.UI.Cards
    Spec.UI.Golden
    Spec.UI.Incidents
    Spec.UI.Layout
    Spec.UI.ReviewSession
    Spec.UI.SolveChooser
    Spec.UI.Text
  ghc-options: -threaded -with-rtsopts=-N1
  build-depends:
    aeson,
    base,
    brick                 >= 2.6 && < 2.11,
    bytestring,
    containers,
    directory,
    filepath,
    hspec                 >= 2.11 && < 2.12,
    kanban,
    process,
    text,
    time,
    unix,
    vector                >= 0.13 && < 0.14,
    vty                   >= 6.2 && < 6.6
